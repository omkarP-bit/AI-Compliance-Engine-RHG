# ACE+RHG Environment Variables

# Service URLs
ACE_URL=http://localhost:8000
RHG_URL=http://localhost:8001
OPA_URL=http://localhost:8181

# Profile
ACE_PROFILE=auto

# API Authentication
ACE_API_KEY=

# Gate Configuration
BLOCK_ON_SEVERITY=HIGH
MAX_MUTATION_RETRIES=3

# LLM Providers (for agents)
NEBIUS_API_KEY=
GROQ_API_KEY=
MODEL_PROVIDER=nebius
NEBIUS_MODEL=

# Notifications
SLACK_WEBHOOK_URL=
SQS_ALERT_QUEUE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OPS_EMAIL_LIST=

# Dashboard (full URL — used verbatim in alerts; may point at Grafana,
# Grafana Cloud or a CloudWatch dashboard)
DASHBOARD_URL=http://localhost:3000/d/ace-rhg-overview

# Metrics
METRICS_BACKEND=
CLOUDWATCH_NAMESPACE=ACE-RHG
# CLOUDWATCH_EMF_ENABLED=true
ACE_METRICS_ENABLED=true
ACE_METRICS_PORT=9090

# Storage
STORAGE_BACKEND=
DYNAMODB_TABLE_PREFIX=ace-internal
DYNAMODB_ENDPOINT_URL=

# AWS (for cloud deployment)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

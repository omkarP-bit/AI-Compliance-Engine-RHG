# Combined ACE + RHG service image for Kubernetes / Helm.
#
# The repo-root Dockerfile targets AWS Lambda (ACE only, Mangum handler). This
# image is the runtime for the Helm chart: it bundles the `ace` package, the
# `rhg` package, and the Rego policies so a single image can serve both
# `uvicorn ace.main:app` and `uvicorn rhg.main:app`.
#
# OPA is a separate Deployment/Service in the chart (see
# infra/helm/ace-rhg/templates/deployment-opa.yaml); the app reaches it via the
# `OPA_URL` env var.
#
#   docker build -f infra/docker/Dockerfile.service -t ace-rhg:0.1.2 .

FROM python:3.12-slim

WORKDIR /var/task

COPY services/ace/requirements.txt ace-requirements.txt
COPY services/rhg/requirements.txt rhg-requirements.txt
RUN pip install --no-cache-dir -r ace-requirements.txt -r rhg-requirements.txt

COPY services/ace/ ace/
COPY services/rhg/ rhg/
COPY services/common/ common/
COPY policies/ policies/

ENV PYTHONPATH=/var/task:/var/task/ace:/var/task/rhg

EXPOSE 8000 8001 9090 9091

# Default to ACE; the RHG Deployment overrides `command` to run rhg.main:app.
CMD ["uvicorn", "ace.main:app", "--host", "0.0.0.0", "--port", "8000"]

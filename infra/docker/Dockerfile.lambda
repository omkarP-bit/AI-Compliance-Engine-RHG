# Lambda container image for the ACE scan + alert dispatcher functions.
#
# Build (must be linux/amd64 — Lambda x86_64):
#   docker build --platform linux/amd64 \
#     -f infra/docker/Dockerfile.lambda \
#     -t <account>.dkr.ecr.<region>.amazonaws.com/ace-rhg-<env>:<tag> .
#
# Both functions share this image: the scan function uses the default CMD
# (`ace.lambda_handler.handler`); the dispatcher overrides ImageConfig.Command to
# `handlers.alert_dispatcher_handler.handler`.
FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

COPY services/ace/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# The scan handler talks to a shared/remote OPA via `OPA_URL`; no OPA binary is
# bundled in the image.
COPY services/ace/ ./ace/
COPY services/rhg/ ./rhg/
COPY services/common/ ./common/
COPY policies/ ./ace/policies/
COPY infra/aws_lambda/handlers/ ./handlers/

CMD ["ace.lambda_handler.handler"]

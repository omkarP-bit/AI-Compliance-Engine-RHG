FROM public.ecr.aws/lambda/python:3.12

WORKDIR /var/task

RUN curl -L -o /usr/local/bin/opa \
    https://github.com/open-policy-agent/opa/releases/download/v0.63.0/opa_linux_amd64_static \
    && chmod +x /usr/local/bin/opa

COPY services/ace/ ./
COPY policies/ ./policies/
COPY infra/aws_lambda/start.sh ./

RUN pip install --no-cache-dir \
    fastapi mangum httpx pydantic langchain-groq langgraph \
    redis sqlalchemy asyncpg celery structlog prometheus-client \
    python-dotenv pyyaml boto3 && \
    chmod +x start.sh

CMD ["handlers.ace_scan_handler.handler"]

package ace.api.security

import future.keywords.if
import future.keywords.in

# OWASP API Security Top 10 (2023) — structural source-code checks.
#
# ACE's regex scanner (``services/ace/scanners/api_regex_scanner.py``) already
# reports line-level findings (hardcoded secrets, dangerous calls, SQL string
# concatenation, ...). This policy deliberately works at file/endpoint level:
# it correlates routes with the guards, limits and middleware that are present
# anywhere in the file, which is something a line scanner cannot do. The rule
# ids are therefore distinct (``API-SEC-OWASP-*``) so a single weakness is not
# counted twice by both engines.
#
# Input is the normalized ``source_code`` artifact produced by
# ``SourceCodeParser``:
#
#   {
#     "kind": "SourceCode",
#     "language": "python",
#     "filename": "app.py",
#     "routes": ["/users/{user_id}"],
#     "content": "... original source ...",
#     "imports": ["fastapi"]
#   }

# Default allow: the API remains usable even if a file is not source code.
# A finding is generated by the ``deny`` rules below; OPA is still the sole
# policy authority for the findings it does emit.
default allow := true

routes := object.get(input, "routes", [])
content := object.get(input, "content", "")

# --- helpers ---------------------------------------------------------------

# Return a finding object with the shape ACE/RHG expect. ``message`` is what
# RHG puts in escalation reasons; ``rule_id``/``severity`` drive scoring and
# the release gate.
_finding(rule_id, title, description, severity, remediation, reference) := {
	"rule_id": rule_id,
	"title": title,
	"description": description,
	"message": description,
	"severity": severity,
	"remediation": remediation,
	"reference": reference,
	"patchable": false,
}

_has(pattern) if {
	regex.match(pattern, content)
}

_route_matches(pattern) if {
	some route in routes
	is_string(route)
	regex.match(pattern, route)
}

_auth_guard if {
	_has(`(?i)(depends\s*\(\s*(?:get_current_user|current_user|oauth2_scheme|bearer|security)|@login_required|@jwt_required|@preauthorize|@secured|@rolesallowed|passport\.authenticate|requireauth|isauthenticated|verifytoken|authmiddleware|ensureloggedin|authenticate\s*\(|httpbearer|oauth2passwordbearer|get_current_user|current_user)`)
}

_object_authz_guard if {
	_has(`(?i)(ensure_owner|check_owner|is_owner|owner_id\s*==|user_id\s*==|tenant_id\s*==|@owns|authorize\s*\(|can\s*\(|has_permission|haspermission|permission_required|@preauthorize|@secured|@rolesallowed|abac|casbin|opa\.)`)
}

_role_guard if {
	_has(`(?i)(@preauthorize|@secured|@rolesallowed|@roles_required|@permission_required|hasrole|has_role|require_role|require_roles|requires_role|roles_required|role\s*==|roles\s*(?:==|in|contains)|is_admin|isadmin|requireadmin|require_admin|admin_middleware|adminmiddleware|permission_required|check_permission|can\s*\(|authorize\s*\(|rbac|casbin|opa\.)`)
}

_rate_limit_guard if {
	_has(`(?i)(rate[_-]?limit|ratelimit|slowapi|limiter\s*\(|limiter\.|express-rate-limit|throttle|captcha|recaptcha|hcaptcha|idempotency|idempotent|bot[_-]?detection|anti[_-]?automation|leaky[_-]?bucket|token[_-]?bucket)`)
}

_pagination_guard if {
	_has(`(?i)(page[_-]?size|per[_-]?page|pagesize|pagination|paginate|page[_-]?number|page[_-]?no|\.take\s*\(|\.limit\s*\(|\blimit\s*[:=]\s*[0-9]|\boffset\s*[:=]|\bcursor\s*[:=]|max[_-]?results|maxresults|LIMIT\s+[0-9])`)
}

_body_limit_guard if {
	_has(`(?i)(max_content_length|max_body_size|client_max_body_size|bodyparser|express\.json\s*\(\s*\{[^}]*limit|multipart[^\n]*limit|file_size|max_file_size)`)
}

_url_allowlist_guard if {
	_has(`(?i)(allowlist|whitelist|allowed_hosts|allowed_domains|allowed_url|is_safe_url|validate_url|valid_url|urlparse|ssrf|safe_redirect|host_allowlist)`)
}

_timeout_guard if {
	_has(`(?i)(\btimeout\s*[:=]|abortcontroller|abort\s*\(|signal\s*[:=]|\.settimeout\s*\(|read[_-]?timeout|connect[_-]?timeout|deadline|max[_-]?time)`)
}

_signature_guard if {
	_has(`(?i)(signature|hmac|verify_webhook|stripe-signature|x-hub-signature|x-signature|svix|webhook_secret|signing_secret)`)
}

_outbound_call if {
	_has(`(?i)(fetch|axios\.(?:get|post|put|patch|delete|request)|requests\.(?:get|post|put|patch|delete|request)|httpx\.(?:get|post|put|patch|delete|request)|http\.(?:get|post|request)|urllib\.request\.urlopen|urlopen|curl_exec|file_get_contents)\s*\(`)
}

_collection_route if {
	some route in routes
	is_string(route)
	not regex.match(`[{]|:`, route)
	regex.match(`(?i)(?:^|/)(?:users|accounts|orders|items|products|transactions|events|logs|records|comments|messages|files|documents|payments|customers|invoices|tickets|scans|findings)$`, route)
}

# --- API1:2023 Broken Object Level Authorization ---------------------------

deny[finding] if {
	_route_matches(`(?i)(?:[{][^}]*(?:id|uuid|key|slug)[^}]*[}]|:[a-z_]*(?:id|uuid|key|slug)\b|<(?:int|uuid|str|string):[^>]+>)`)
	not _object_authz_guard
	finding := _finding(
		"API-SEC-OWASP-API1",
		"Object identifier route without object-level authorization",
		"An endpoint addresses an object by id but the file contains no ownership/authorization check. Attackers can often replace the id and access another tenant's object (BOLA).",
		"HIGH",
		"Authorize every object access against the authenticated subject (owner/tenant check) before returning or mutating it.",
		"https://owasp.org/API-Security/editions/2023/en/0xa1-broken-object-level-authorization/",
	)
}

# --- API2:2023 Broken Authentication ---------------------------------------

deny[finding] if {
	_route_matches(`(?i)(?:^|/)(?:login|signin|signup|register|token|session|password|reset|forgot|logout|otp|mfa|2fa|authenticate)(?:/|$)`)
	_has(`(?i)(?:request|req)\.(?:args|query|params|GET|POST)\.?(?:\[|\.get\s*\()\s*["']?(?:password|passwd|pwd|token|otp|secret|api[_-]?key)`)
	finding := _finding(
		"API-SEC-OWASP-API2-QUERY-CREDENTIALS",
		"Credentials accepted from the query string",
		"An authentication endpoint reads a password/token/OTP from query parameters. Credentials in URLs leak through logs, proxies, browser history and Referer headers.",
		"HIGH",
		"Accept credentials only in the request body over HTTPS; never in the URL or query string.",
		"https://owasp.org/API-Security/editions/2023/en/0xa2-broken-authentication/",
	)
}

deny[finding] if {
	_has(`(?i)set_cookie\s*\(`)
	not _has(`(?i)(httponly\s*[:=]\s*true|secure\s*[:=]\s*true|samesite)`)
	finding := _finding(
		"API-SEC-OWASP-API2-COOKIE-FLAGS",
		"Session cookie without HttpOnly/Secure/SameSite",
		"The file sets a cookie without the hardening flags that stop script access, plaintext transport and cross-site sending.",
		"MEDIUM",
		"Set HttpOnly, Secure and an explicit SameSite value on every authentication/session cookie.",
		"https://owasp.org/API-Security/editions/2023/en/0xa2-broken-authentication/",
	)
}

# --- API3:2023 Broken Object Property Level Authorization ------------------

deny[finding] if {
	_has(`(?i)(\*\*\s*(?:await\s+)?(?:request|req)\.(?:json|form|data|get_json)\s*\(|new\s+[A-Za-z_]\w*\s*\(\s*(?:req|request)\.body\s*\)|\.create\s*\(\s*(?:req|request)\.body\s*\)|params\.permit!)`)
	finding := _finding(
		"API-SEC-OWASP-API3-MASS-ASSIGNMENT",
		"Raw request payload bound to a model",
		"The handler spreads the complete request payload into a model/create call. Clients can set fields that are not meant to be writable (role, owner, balance, ...).",
		"HIGH",
		"Bind an explicit allowlist/DTO of writable fields and reject unknown properties.",
		"https://owasp.org/API-Security/editions/2023/en/0xa3-broken-object-property-level-authorization/",
	)
}

deny[finding] if {
	_has(`(?i)(fields\s*=\s*["']__all__["']|serialize\s*\(\s*["']__all__["']\s*\))`)
	finding := _finding(
		"API-SEC-OWASP-API3-EXCESSIVE-FIELDS",
		"Serializer exposes every model field",
		"Using ``__all__`` in a serializer returns internal fields (password hashes, tokens, flags) to API clients (excessive data exposure).",
		"MEDIUM",
		"List the response fields explicitly and exclude secrets/internal columns.",
		"https://owasp.org/API-Security/editions/2023/en/0xa3-broken-object-property-level-authorization/",
	)
}

# --- API4:2023 Unrestricted Resource Consumption ---------------------------

deny[finding] if {
	_collection_route
	not _pagination_guard
	finding := _finding(
		"API-SEC-OWASP-API4-NO-PAGINATION",
		"Collection endpoint without pagination limits",
		"A collection route returns a full table/collection with no page size, offset, cursor or limit in the file. Large datasets enable resource-exhaustion and data-scraping attacks.",
		"MEDIUM",
		"Enforce a server-side maximum page size and require page/cursor parameters on collection endpoints.",
		"https://owasp.org/API-Security/editions/2023/en/0xa4-unrestricted-resource-consumption/",
	)
}

deny[finding] if {
	_route_matches(`(?i)(?:^|/)(?:upload|uploads|import|imports|attachments)(?:/|$)`)
	not _body_limit_guard
	finding := _finding(
		"API-SEC-OWASP-API4-UPLOAD-LIMIT",
		"File upload route without a body size limit",
		"An upload/import route exists but the file declares no request-size or file-size limit, allowing disk/memory exhaustion.",
		"MEDIUM",
		"Set an explicit maximum request and file size (and reject oversized bodies before reading them).",
		"https://owasp.org/API-Security/editions/2023/en/0xa4-unrestricted-resource-consumption/",
	)
}

# --- API5:2023 Broken Function Level Authorization -------------------------

deny[finding] if {
	_route_matches(`(?i)(?:^|/)(?:admin|internal|manage|management|root|superuser|staff|backoffice|ops|sysadmin)(?:/|$)`)
	not _role_guard
	finding := _finding(
		"API-SEC-OWASP-API5-PRIVILEGED-ROUTE",
		"Privileged route without a role check",
		"An administrative/internal route is defined without any role or permission guard in the file. Missing function-level checks let ordinary users invoke privileged operations.",
		"HIGH",
		"Enforce a role/permission check (deny by default) on every administrative or internal endpoint.",
		"https://owasp.org/API-Security/editions/2023/en/0xa5-broken-function-level-authorization/",
	)
}

# --- API6:2023 Unrestricted Access to Sensitive Business Flows -------------

deny[finding] if {
	_route_matches(`(?i)(?:^|/)(?:login|signin|signup|register|checkout|payment|payments|purchase|order|orders|transfer|withdraw|deposit|refund|password|reset|forgot|otp|verify|redeem|coupon|booking|reservation|invite)(?:/|$)`)
	not _rate_limit_guard
	finding := _finding(
		"API-SEC-OWASP-API6-NO-ANTI-AUTOMATION",
		"Sensitive business flow without anti-automation controls",
		"A login, registration, payment, order or similar business flow has no rate limit, CAPTCHA or idempotency control in the file. Attackers can script abuse, credential stuffing or duplicate transactions.",
		"MEDIUM",
		"Add per-user/IP rate limiting, idempotency keys for transactional flows and bot protection for registration/login.",
		"https://owasp.org/API-Security/editions/2023/en/0xa6-unrestricted-access-to-sensitive-business-flows/",
	)
}

# --- API7:2023 Server Side Request Forgery --------------------------------

deny[finding] if {
	_has(`(?i)\b(?:url|uri|target|host|endpoint|callback|redirect|next|destination|webhook|feed)\w*\s*[:=]\s*[^\n]*(?:request|req)\.(?:args|query|params|body|json|form|GET|POST)`)
	_outbound_call
	not _url_allowlist_guard
	finding := _finding(
		"API-SEC-OWASP-API7-SSRF",
		"Outbound request URL derived from user input",
		"User-controlled request data is assigned to a URL-like variable and later used by an outbound HTTP client, with no allowlist/URL validation in the file (SSRF).",
		"HIGH",
		"Resolve and allowlist destinations (scheme, host, port) before calling outbound services; block link-local/metadata addresses.",
		"https://owasp.org/API-Security/editions/2023/en/0xa7-server-side-request-forgery/",
	)
}

# --- API8:2023 Security Misconfiguration ----------------------------------

deny[finding] if {
	_has(`(?i)(verify\s*[:=]\s*false|rejectunauthorized\s*:\s*false|node_tls_reject_unauthorized\s*=\s*["']?0|insecureskipverify\s*:\s*true|trustallcerts|ssl_verify\s*=\s*false|disable_ssl_verification|curlopt_ssl_verifypeer\s*,\s*(?:0|false))`)
	finding := _finding(
		"API-SEC-OWASP-API8-TLS-VERIFY",
		"TLS certificate verification disabled",
		"An HTTP client disables certificate validation, allowing man-in-the-middle interception of API traffic.",
		"HIGH",
		"Never disable certificate verification; trust the correct CA bundle instead.",
		"https://owasp.org/API-Security/editions/2023/en/0xa8-security-misconfiguration/",
	)
}

deny[finding] if {
	_has(`(?i)(allow_origins\s*=\s*\[\s*["'][*]["']|allowedorigins\s*\(\s*["'][*]["']|addallowedorigin\s*\(\s*["'][*]["'])`)
	finding := _finding(
		"API-SEC-OWASP-API8-CORS-WILDCARD",
		"CORS policy allows every origin",
		"A wildcard CORS configuration lets any website call the API with the user's browser credentials.",
		"MEDIUM",
		"Allow only the explicit list of trusted origins and avoid wildcard with credentials.",
		"https://owasp.org/API-Security/editions/2023/en/0xa8-security-misconfiguration/",
	)
}

deny[finding] if {
	_has(`(?i)(introspection\s*[:=]\s*true|graphiql\s*[:=]\s*true|__schema\s*[{])`)
	finding := _finding(
		"API-SEC-OWASP-API8-GRAPHQL-INTROSPECTION",
		"GraphQL introspection or GraphiQL enabled",
		"GraphQL introspection/GraphiQL is enabled in application code, exposing the full schema and often an interactive console.",
		"MEDIUM",
		"Disable introspection and GraphiQL in production; expose them only in local development.",
		"https://owasp.org/API-Security/editions/2023/en/0xa8-security-misconfiguration/",
	)
}

# --- API9:2023 Improper Inventory Management ------------------------------

deny[finding] if {
	_route_matches(`(?i)(?:^|/)(?:actuator|swagger|swagger-ui|openapi[.]json|api-docs|debug|metrics|console|graphiql|phpinfo|trace|env)(?:/|$|[.])`)
	finding := _finding(
		"API-SEC-OWASP-API9-MANAGEMENT-ENDPOINT",
		"Management/debug endpoint exposed by the API",
		"A management, debug or documentation endpoint (actuator, swagger, debug, metrics, console, ...) is part of the application routes and may be reachable in production.",
		"MEDIUM",
		"Remove these endpoints from the production build or restrict them to an authenticated internal network.",
		"https://owasp.org/API-Security/editions/2023/en/0xa9-improper-inventory-management/",
	)
}

api_versions := {version |
	some route in routes
	is_string(route)
	version := regex.find_all_string_submatch_n(`(?i)(?:^|/)v([0-9]+)(?:/|$)`, route, -1)[_][1]
}

deny[finding] if {
	count(api_versions) > 1
	finding := _finding(
		"API-SEC-OWASP-API9-VERSION-SPRAWL",
		"Multiple API versions served by the same file",
		"Routes for more than one major API version are defined together, which makes old/undocumented versions easy to forget and keep exposed.",
		"LOW",
		"Retire superseded versions, document the supported inventory and isolate version routers.",
		"https://owasp.org/API-Security/editions/2023/en/0xa9-improper-inventory-management/",
	)
}

# --- API10:2023 Unsafe Consumption of APIs --------------------------------

deny[finding] if {
	_route_matches(`(?i)(?:webhook|webhooks|callback|callbacks|hook|hooks)(?:/|$)`)
	not _signature_guard
	finding := _finding(
		"API-SEC-OWASP-API10-WEBHOOK-SIGNATURE",
		"Inbound webhook/callback without signature verification",
		"A webhook or callback route exists but the file contains no signature/HMAC verification, so forged third-party events are accepted.",
		"HIGH",
		"Verify the provider's signature/HMAC (with replay protection) before trusting the payload.",
		"https://owasp.org/API-Security/editions/2023/en/0xa10-unsafe-consumption-of-apis/",
	)
}

deny[finding] if {
	_outbound_call
	not _timeout_guard
	finding := _finding(
		"API-SEC-OWASP-API10-NO-TIMEOUT",
		"Third-party API call without a timeout",
		"The file calls an external HTTP API but declares no timeout/abort/deadline. A slow or malicious third party can exhaust worker threads and take the API down.",
		"MEDIUM",
		"Always set connect and read timeouts, and fail closed when a dependency does not answer.",
		"https://owasp.org/API-Security/editions/2023/en/0xa10-unsafe-consumption-of-apis/",
	)
}
